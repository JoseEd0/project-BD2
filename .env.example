# Variables de entorno del gestor. Copia este archivo a `.env` y ajusta lo que haga falta;
# `.env` no se versiona. Ninguna ruta, puerto ni credencial está escrita en el código.

# --- API (src/api) ---
# Directorio donde viven los archivos del gestor: tablas, índices y catálogo.
MINIGESTOR_DATA_DIR=./data
# Directorios, además del de datos, de los que `CREATE TABLE ... FROM FILE` puede leer,
# separados por comas. Fuera de ellos y del de datos, la carga se rechaza.
MINIGESTOR_IMPORT_DIRS=./demos/samples
# Orígenes desde los que el frontend llama al API, separados por comas. Obligatoria: sin
# ella el servidor no arranca.
MINIGESTOR_CORS_ORIGINS=http://localhost:5173
# Segundos que una transacción espera un bloqueo. En una demostración en vivo conviene
# subirlo, para que una transacción abierta no caduque mientras se explica.
MINIGESTOR_LOCK_TIMEOUT=5

# --- Docker (compose.yaml) ---
# Puertos del anfitrión en los que `docker compose up` publica la interfaz y el API. Las
# variables del API de arriba no se usan con Docker: la imagen y el compose ya las fijan.
# MINIGESTOR_WEB_PORT=8080
# MINIGESTOR_API_PORT=8000
# Carpeta de los datos descargados que el perfil `bench` monta como data/datasets/.
# MINIGESTOR_DATASETS_DIR=./data/datasets

# --- Experimentos (benchmarks/spatial_benchmark.py) ---
# Conexión al PostgreSQL contra el que se mide GiST. Necesita la extensión PostGIS. Con
# Docker (perfil `bench`) no hace falta: el compose la fija.
# Sin esta variable el experimento espacial mide solo las dos técnicas del motor.
BENCH_POSTGRES_DSN=dbname=minigestor_bench

# --- Tests (tests/demos/test_dataset.py) ---
# Carpeta del corpus ESCI descargado (ver benchmarks/esci/README.md). Con ella, el test
# comprueba además que la muestra de demos/samples/esci/ se regenera idéntica.
# ESCI_CORPUS_DIR=data/datasets/esci_es
