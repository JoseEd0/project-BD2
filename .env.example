# Variables de entorno del gestor. Copia este archivo a `.env` y ajusta lo que haga falta;
# `.env` no se versiona. Ninguna ruta, puerto ni credencial está escrita en el código.

# --- API (src/api) ---
# Directorio donde viven los archivos del gestor: tablas, índices y catálogo.
MINIGESTOR_DATA_DIR=./data
# Orígenes a los que el API permite llamar, separados por comas.
MINIGESTOR_CORS_ORIGINS=http://localhost:5173
# Segundos que una transacción espera un bloqueo. En una demostración en vivo conviene
# subirlo, para que una transacción abierta no caduque mientras se explica.
MINIGESTOR_LOCK_TIMEOUT=5

# --- Experimentos (benchmarks/spatial_benchmark.py) ---
# Conexión al PostgreSQL contra el que se mide GiST. Necesita la extensión PostGIS.
# Sin esta variable el experimento espacial mide solo las dos técnicas del motor.
BENCH_POSTGRES_DSN=dbname=minigestor_bench
