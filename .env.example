# Variables de entorno del gestor. Copia este archivo a `.env` y ajusta lo que haga falta;
# `.env` no se versiona. Ninguna ruta, puerto ni credencial está escrita en el código.

# --- API (src/api) ---
# Directorio donde viven los archivos del gestor: tablas, índices y catálogo.
MINIGESTOR_DATA_DIR=./data
# Directorios, además del de datos, de los que `CREATE TABLE ... FROM FILE` puede leer,
# separados por comas, y donde pueden estar las imágenes y audios de una columna con índice
# HNSW o IVF y el archivo de un `SIMILAR_TO`. Fuera de ellos y del de datos, se rechaza.
MINIGESTOR_IMPORT_DIRS=./demos/samples,./data/datasets
# Orígenes desde los que el frontend llama al API, separados por comas. Obligatoria: sin
# ella el servidor no arranca.
MINIGESTOR_CORS_ORIGINS=http://localhost:5173
# Segundos que una transacción espera un bloqueo. En una demostración en vivo conviene
# subirlo, para que una transacción abierta no caduque mientras se explica.
MINIGESTOR_LOCK_TIMEOUT=5
# Segundos que puede durar cada sentencia; al pasarlos se corta y se deshace.
MINIGESTOR_STATEMENT_TIMEOUT=30
# Bytes que admite el cuerpo de una petición que no sube un archivo (8 MiB).
MINIGESTOR_MAX_REQUEST_BYTES=8388608
# Nivel de los logs, que salen en JSON por la salida estándar: DEBUG, INFO, WARNING, ERROR.
MINIGESTOR_LOG_LEVEL=INFO
# Claves de los servicios que se conectan al API, separadas por comas, cada una como
# `servicio:rol:sha256`. El rol es `read` (consultas), `write` (además INSERT, UPDATE y
# DELETE) o `admin` (además CREATE, DROP y cargar archivos). Se guarda el SHA-256 de la
# clave, nunca la clave; el servicio la envía como `Authorization: Bearer <clave>`.
# Para crear una:
#   clave=$(python3 -c "import secrets; print(secrets.token_urlsafe(32))")
#   printf %s "$clave" | shasum -a 256      # o sha256sum
# Vacía o sin definir, el API queda abierto a cualquiera: solo para desarrollo.
# MINIGESTOR_API_KEYS=consola:admin:<sha256>,recomendador:read:<sha256>

# --- Docker (compose.yaml) ---
# Puertos del anfitrión en los que `docker compose up` publica la interfaz y el API. Las
# variables del API de arriba no se usan con Docker: la imagen y el compose ya las fijan.
# MINIGESTOR_WEB_PORT=8080
# MINIGESTOR_API_PORT=8000
# Carpeta de los datos descargados que el perfil `bench` monta como data/datasets/.
# MINIGESTOR_DATASETS_DIR=./data/datasets
# Con claves en MINIGESTOR_API_KEYS, la clave en claro de la consola: nginx la añade a cada
# petición que reenvía al API, así que nunca entra en el bundle del navegador. Su hash va
# en MINIGESTOR_API_KEYS con el rol que deba tener la consola (admin, para crear tablas).
# MINIGESTOR_CONSOLE_KEY=

# --- Experimentos (benchmarks/spatial_benchmark.py) ---
# Conexión al PostgreSQL contra el que se mide GiST. Necesita la extensión PostGIS. Con
# Docker (perfil `bench`) no hace falta: el compose la fija.
# Sin esta variable el experimento espacial mide solo las dos técnicas del motor.
BENCH_POSTGRES_DSN=dbname=minigestor_bench

# --- Tienda (apps/shop) ---
# Carpeta de datasets en la que `python -m shop.dataset prepare` deja el suyo, si no se le
# da `--data-dir`. Ver apps/shop/README.md.
# SHOP_DATA_DIR=./data/datasets

# --- Tests (tests/demos/test_dataset.py) ---
# Carpeta del corpus ESCI descargado (ver benchmarks/esci/README.md). Con ella, el test
# comprueba además que la muestra de demos/samples/esci/ se regenera idéntica.
# ESCI_CORPUS_DIR=data/datasets/esci_es
