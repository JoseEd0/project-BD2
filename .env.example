# Variables de entorno del gestor. Copia este archivo a `.env` y ajusta lo que haga falta;
# `.env` no se versiona. Ninguna ruta, puerto ni credencial está escrita en el código.

# --- API (src/api) ---
# Directorio donde viven los archivos del gestor: tablas, índices y catálogo.
MINIGESTOR_DATA_DIR=./data
# Directorios, además del de datos, de los que `CREATE TABLE ... FROM FILE` puede leer,
# separados por comas, y donde pueden estar las imágenes y audios de una columna con índice
# HNSW o IVF y el archivo de un `SIMILAR_TO`. Fuera de ellos y del de datos, se rechaza.
MINIGESTOR_IMPORT_DIRS=./demos/samples,./data/datasets
# Orígenes desde los que el frontend llama al API, separados por comas. Obligatoria: sin
# ella el servidor no arranca.
MINIGESTOR_CORS_ORIGINS=http://localhost:5173
# Segundos que una transacción espera un bloqueo. En una demostración en vivo conviene
# subirlo, para que una transacción abierta no caduque mientras se explica.
MINIGESTOR_LOCK_TIMEOUT=5
# Segundos que puede durar cada sentencia; al pasarlos se corta y se deshace.
MINIGESTOR_STATEMENT_TIMEOUT=30
# Bytes que admite el cuerpo de una petición que no sube un archivo (8 MiB).
MINIGESTOR_MAX_REQUEST_BYTES=8388608
# Carga masiva (`POST /tables/{name}/rows`): filas por lote, que entra entero o no entra, y
# bytes que puede tener cada línea (una fila). Esa ruta no limita el cuerpo entero: lo lee
# por partes y nunca lo tiene completo en memoria.
MINIGESTOR_INGEST_BATCH_ROWS=1000
MINIGESTOR_MAX_INGEST_LINE_BYTES=262144
# Nivel de los logs, que salen en JSON por la salida estándar: DEBUG, INFO, WARNING, ERROR.
MINIGESTOR_LOG_LEVEL=INFO
# Claves de los servicios que se conectan al API, separadas por comas, cada una como
# `servicio:rol:sha256`. El rol es `read` (consultas), `write` (además INSERT, UPDATE y
# DELETE) o `admin` (además CREATE, DROP y cargar archivos). Se guarda el SHA-256 de la
# clave, nunca la clave; el servicio la envía como `Authorization: Bearer <clave>`.
# Para crear una:
#   clave=$(python3 -c "import secrets; print(secrets.token_urlsafe(32))")
#   printf %s "$clave" | shasum -a 256      # o sha256sum
# Vacía o sin definir, el API queda abierto a cualquiera: solo para desarrollo.
# MINIGESTOR_API_KEYS=consola:admin:<sha256>,recomendador:read:<sha256>

# --- Docker (compose.yaml) ---
# Las variables del API de arriba no se usan con Docker: la imagen y el compose ya las fijan.
#
# Claves de los servicios. `python -m tools.compose_keys` (o `python3 -m tools.compose_keys`
# sin uv) las crea en `.env`: una en claro para cada servicio y, con sus SHA-256 y roles,
# MINIGESTOR_API_KEYS, que lee el gestor. Repetirlo conserva las que ya están. Sin claves,
# el gestor queda abierto: solo para desarrollar.
#   consola                 MINIGESTOR_CONSOLE_KEY     admin (nginx la añade; nunca va al bundle)
#   cada app, peticiones    <PREFIJO>ENGINE_KEY        write
#   cada app, migraciones   <PREFIJO>MIGRATION_KEY     admin (solo al arrancar)
# Prefijos: COPYRIGHT_, SHOP_, RAG_ (papers), FACES_; EJEMPLO_ el del servicio de ejemplo.
# MINIGESTOR_API_KEYS=consola:admin:<sha256>,shop:write:<sha256>,shop-migraciones:admin:<sha256>
# MINIGESTOR_CONSOLE_KEY=
# SHOP_ENGINE_KEY=
# SHOP_MIGRATION_KEY=
# COPYRIGHT_ENGINE_KEY=
# COPYRIGHT_MIGRATION_KEY=
#
# Gestor (`engine`): no publica puertos. Nivel de log y tope de memoria del contenedor.
# MINIGESTOR_LOG_LEVEL=INFO
# MINIGESTOR_ENGINE_MEMORY=4g
# Solo con deploy/compose.dev.yaml: el puerto del anfitrión donde se publica el gestor y los
# orígenes que admite (los de `npm run dev`).
# MINIGESTOR_API_PORT=8000
# MINIGESTOR_DEV_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Consola (`console`): su puerto y su tope de memoria.
# MINIGESTOR_WEB_PORT=8080
# MINIGESTOR_CONSOLE_MEMORY=128m
# Carpeta de los datos descargados que el gestor y el perfil `bench` montan como data/datasets/.
# MINIGESTOR_DATASETS_DIR=./data/datasets
#
# Redis (`redis`, red interna `cache`): versión de la imagen, memoria de la caché y del
# contenedor.
# REDIS_VERSION=8.8.4-alpine
# REDIS_MAXMEMORY=256mb
# REDIS_MEMORY=320m
#
# Aplicaciones. Cada `<app>-web` publica su puerto HTTP y, con certificado, el HTTPS paralelo:
#   copyright 8101 / 8401   shop 8102 / 8402   papers 8103 / 8403   faces 8104 / 8404
#   ejemplo (perfil `example`) 8100 / 8400
# COPYRIGHT_WEB_PORT=8101
# COPYRIGHT_WEB_TLS_PORT=8401
# SHOP_WEB_PORT=8102
# SHOP_WEB_TLS_PORT=8402
# PAPERS_WEB_PORT=8103
# PAPERS_WEB_TLS_PORT=8403
# FACES_WEB_PORT=8104
# FACES_WEB_TLS_PORT=8404
# EXAMPLE_WEB_PORT=8100
# EXAMPLE_WEB_TLS_PORT=8400
# Nivel de log de cada API (con su prefijo), y topes de memoria por omisión de cada API y
# cada web (una app puede fijar el suyo en su compose).
# SHOP_LOG_LEVEL=INFO
# COPYRIGHT_LOG_LEVEL=INFO
# APP_API_MEMORY=512m
# APP_WEB_MEMORY=128m
# Carpeta con cert.pem y key.pem para el HTTPS de cada web; la crea `deploy/certs.sh`. Por
# omisión, data/certs del repositorio; si se cambia, con ruta absoluta (una relativa, el
# compose la leería desde deploy/). Sin certificado, las webs sirven solo HTTP.
# MINIGESTOR_CERTS_DIR=/ruta/absoluta/certs
# Papers (RAG, apps/rag/compose.yaml): hilos de onnxruntime y tope de memoria de cada réplica
# de su API, límite de peticiones de su nginx y, para su carga inicial (perfil `seed`), la
# carpeta de datasets con `rag_papers/` (relativa a apps/rag/ o absoluta), sus hilos, la
# caché de embeddings dentro del contenedor y su tope de memoria.
# RAG_LOG_LEVEL=INFO
# RAG_EMBEDDING_THREADS=2
# PAPERS_API_MEMORY=1g
# PAPERS_API_RATE_LIMIT=5r/s
# PAPERS_API_RATE_BURST=10
# PAPERS_DATASETS_DIR=../../data/datasets
# RAG_SEED_EMBEDDING_THREADS=4
# RAG_SEED_EMBEDDING_CACHE_DIR=/data/datasets/rag_papers/embeddings
# RAG_ENGINE_LOAD_TIMEOUT_SECONDS=3600
# PAPERS_SEED_MEMORY=2g
# Respuestas de papers con Claude (POST /api/answers). La clave de la API de Anthropic va
# solo aquí y llega solo a papers-api; sin ella, /answers responde 503 y la búsqueda sigue.
# `simulated` responde sin red ni costo (la CI). Esfuerzo, tope de salida por respuesta y
# gasto máximo del día por réplica, en dólares (ver apps/rag/README.md, «Respuestas»).
# RAG_ANTHROPIC_API_KEY=
# RAG_LLM_PROVIDER=anthropic
# RAG_ANSWER_EFFORT=low
# RAG_ANSWER_MAX_TOKENS=2048
# RAG_DAILY_BUDGET_USD=5
# Versión de cloudflared del perfil `tunnel`.
# CLOUDFLARED_VERSION=2026.10.7

# --- Experimentos (benchmarks/spatial_benchmark.py) ---
# Conexión al PostgreSQL contra el que se mide GiST. Necesita la extensión PostGIS. Con
# Docker (perfil `bench`) no hace falta: el compose la fija.
# Sin esta variable el experimento espacial mide solo las dos técnicas del motor.
BENCH_POSTGRES_DSN=dbname=minigestor_bench

# --- Copyright en audio (apps/copyright) ---
# Carpeta de datasets en la que `python -m songcheck.fma` deja el catálogo de FMA
# (fma_small/, 7,4 GB) y de la que lo lee `python -m songcheck.seed`. El gestor lee el audio
# por su ruta: la carpeta va en MINIGESTOR_IMPORT_DIRS. Ver apps/copyright/README.md.
# COPYRIGHT_DATA_DIR=./data/datasets
# Fuera de Docker: el gestor del API y de la carga. Las claves son COPYRIGHT_ENGINE_KEY y
# COPYRIGHT_MIGRATION_KEY, las de arriba; la carga usa la de migraciones (admin).
# COPYRIGHT_ENGINE_URL=http://localhost:8000
# La misma carpeta de datasets tal como la ve el gestor, si es otra ruta (por omisión,
# COPYRIGHT_DATA_DIR en absoluto; el compose no la necesita: monta las dos en la misma).
# COPYRIGHT_ENGINE_DATA_DIR=/app/data/datasets
# Pistas que baja a la vez y cuánto espera la carga el CREATE INDEX del catálogo entero.
# COPYRIGHT_DOWNLOAD_THREADS=4
# COPYRIGHT_INDEX_TIMEOUT_SECONDS=3600
# La detección (POST /detections): el audio más pesado y el más largo, los vecinos por
# ventana, la racha mínima, el umbral del puntaje (provisional; lo calibra #77), cuántas
# coincidencias se devuelven y el nivel por debajo del cual una ventana es silencio. La web
# deja pasar un cuerpo algo mayor que el audio máximo, por el multipart.
# COPYRIGHT_MAX_UPLOAD_BYTES=50331648
# COPYRIGHT_MAX_UPLOAD_SECONDS=600
# COPYRIGHT_NEIGHBOURS_PER_WINDOW=10
# COPYRIGHT_MIN_RUN_WINDOWS=2
# COPYRIGHT_MATCH_THRESHOLD=0.43
# COPYRIGHT_MAX_MATCHES=10
# COPYRIGHT_SILENCE_THRESHOLD_DBFS=-60
# COPYRIGHT_WEB_MAX_BODY_SIZE=49m

# --- Tienda (apps/shop) ---
# Carpeta de datasets en la que `python -m shop.dataset prepare` deja el suyo, si no se le
# da `--data-dir`, y de la que lo lee `python -m shop.seed`. Ver apps/shop/README.md.
# SHOP_DATA_DIR=./data/datasets
# Carpeta de CLIP en ONNX (`python -m shop.clip models`). Sin ella, los tests de CLIP se
# saltan; el API y la carga no arrancan.
# SHOP_MODELS_DIR=./data/models/shop
# Fuera de Docker: el gestor del API y de la carga. Las claves son SHOP_ENGINE_KEY y
# SHOP_MIGRATION_KEY, las de arriba; la carga usa la de migraciones (admin).
# SHOP_ENGINE_URL=http://localhost:8000
# La carpeta de datasets vista desde el gestor, si la ve en otra ruta (la columna `imagen`
# guarda esa ruta, y tiene que estar en su MINIGESTOR_IMPORT_DIRS). En el compose, los dos
# la montan en /app/data/datasets y no hace falta.
# SHOP_ENGINE_DATA_DIR=/app/data/datasets
# Caché de recomendaciones en Redis (en el compose, el servicio `redis` de la red `cache`).
# Sin ella no hay caché; si Redis no responde, el API contesta sin ella. TTL en segundos.
# SHOP_REDIS_URL=redis://localhost:6379/0
# SHOP_CACHE_TTL_SECONDS=600
# Recomendador: partición de las compras que lo alimenta, candidatos por señal, radio de la
# cercanía en metros, parecido visual (clip o sift) y pesos de la fusión (#82 los ajusta).
# SHOP_RECOMMENDATION_SPLIT=train
# SHOP_CANDIDATES_PER_SIGNAL=50
# SHOP_NEARBY_RADIUS_METERS=5000
# SHOP_VISUAL_SIGNAL=clip
# SHOP_COPURCHASE_WEIGHT=0.4
# SHOP_VISUAL_WEIGHT=0.25
# SHOP_TEXT_WEIGHT=0.25
# SHOP_NEARBY_WEIGHT=0.1
# Carga: clientes mínimos de un par de compras conjuntas, pares que se guardan por producto
# y compras de entrenamiento por lote del GROUP BY que los calcula.
# SHOP_COPURCHASE_MIN_SUPPORT=2
# SHOP_COPURCHASE_MAX_PARTNERS=500
# SHOP_COPURCHASE_CHUNK_BUYERS=10000
# Con Docker: topes de memoria del API (con la torre de texto de CLIP, unos 430 MiB) y de
# la carga (la torre de imagen y los lotes de fotos).
# SHOP_API_MEMORY=1g
# SHOP_SEED_MEMORY=3g

# --- Servicio de rostros (apps/faces) ---
# Carpeta de los modelos YuNet y SFace; se bajan con `python -m faces models`. Sin ella, los
# tests que corren los modelos se saltan.
# FACES_MODELS_DIR=./data/models/faces
# El API (`uvicorn --factory faces.api:create_app`) habla con el gestor con una clave
# `write` y migra sus tablas con otra `admin` (ver apps/kit/README.md).
# FACES_ENGINE_URL=http://engine:8000
# FACES_ENGINE_KEY=
# FACES_MIGRATION_KEY=
# Días que dura un registro (Ley 29733: se borra solo al vencer) y minutos de una sesión de
# registro sin terminar. El resto de límites y umbrales, en apps/faces/README.md.
# FACES_RETENTION_DAYS=30
# FACES_ENROLLMENT_TTL_SECONDS=900
# Con Docker (apps/faces/compose.yaml): FACES_MODELS_DIR la fija el compose (los modelos van
# en la imagen), y además el tope de memoria de cada réplica, lo que analiza a la vez y los
# límites del nginx de su web: tamaño de la subida (una foto de FACES_MAX_UPLOAD_BYTES más el
# multipart) y peticiones por IP, más bajas que en otras apps porque cada foto cuesta CPU.
# FACES_API_MEMORY=1g
# FACES_ANALYSIS_WORKERS=2
# FACES_MAX_UPLOAD_BYTES=10485760
# FACES_WEB_MAX_BODY_SIZE=11m
# FACES_WEB_RATE_LIMIT=5r/s
# FACES_WEB_RATE_BURST=20
# FACES_LOG_LEVEL=INFO
# Reconocimiento en vivo (WebSocket /ws/recognize): el Redis de los rastros (sin él, cada
# rostro de cada cuadro se busca), cuadros por segundo por conexión y conexiones por réplica.
# FACES_REDIS_URL=redis://redis:6379/1
# FACES_STREAM_MAX_FPS=15
# FACES_STREAM_MAX_CONNECTIONS=16

# --- Corpus y servicio del RAG (apps/rag) ---
# Carpeta de datos donde `python -m rag.corpus build` deja `rag_papers/` y de donde
# `python -m rag.seed` la lee, si no se les pasa `--data-dir`.
# RAG_DATA_DIR=data/datasets
# Carpeta del modelo de embeddings (multilingual-e5-small en ONNX); se baja con
# `python -m rag.models`. Sin ella, los tests que corren el modelo se saltan.
# RAG_MODELS_DIR=./data/models/rag
# Fuera de Docker, el gestor y las claves del servicio (ver apps/kit/README.md): la de
# escritura atiende y carga; la de administración solo aplica las migraciones. En el compose
# las pone `python -m tools.compose_keys`.
# RAG_ENGINE_URL=http://localhost:8000
# RAG_ENGINE_KEY=
# RAG_MIGRATION_KEY=
# Variante del modelo (int8 o fp32; la imagen de Docker trae solo int8). Los hilos de
# onnxruntime (RAG_EMBEDDING_THREADS) son, fuera de Docker, los núcleos de la máquina.
# RAG_EMBEDDING_MODEL=int8
# Fuera de Docker, el resto de las respuestas: modelo, respaldo del servidor, fragmentos
# recuperados, tokens de documentos en el prompt, constante de RRF y la API de Anthropic.
# RAG_ANSWER_MODEL=claude-sonnet-5-5
# RAG_ANSWER_SERVER_FALLBACK=true
# RAG_ANSWER_CHUNKS=12
# RAG_ANSWER_CONTEXT_TOKENS=9000
# RAG_RRF_K=60
# RAG_ANTHROPIC_TIMEOUT_SECONDS=60
# RAG_ANTHROPIC_MAX_RETRIES=2

# --- Tests (tests/demos/test_dataset.py) ---
# Carpeta del corpus ESCI descargado (ver benchmarks/esci/README.md). Con ella, el test
# comprueba además que la muestra de demos/samples/esci/ se regenera idéntica.
# ESCI_CORPUS_DIR=data/datasets/esci_es
