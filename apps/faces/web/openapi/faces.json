          },
          "not_stored": {
            "type": "string",
            "title": "Not Stored"
          },
          "retention_days": {
            "type": "integer",
            "title": "Retention Days"
          },
          "retention": {
            "type": "string",
            "title": "Retention"
          },
          "rights": {
            "type": "string",
            "title": "Rights"
