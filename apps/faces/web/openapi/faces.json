            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Identification": {
        "properties": {
          "faces": {
            "items": {
              "$ref": "#/components/schemas/IdentifiedFace"
            },
            "type": "array",
            "title": "Faces",
            "description": "Del rostro más grande al más chico."
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "faces",
          "message"
        ],
        "title": "Identification"
      },
      "IdentifiedFace": {
        "properties": {
          "box": {
            "$ref": "#/components/schemas/FaceBox"
          },
          "status": {
            "$ref": "#/components/schemas/MatchStatus"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score",
            "description": "El coseno con la persona más parecida, la reconozca o no."
          }
        },
        "type": "object",
        "required": [
          "box",
          "status"
        ],
        "title": "IdentifiedFace"
      },
      "MatchStatus": {
        "type": "string",
        "enum": [
          "known",
          "unknown",
          "too_small"
        ],
        "title": "MatchStatus"
      },
      "Person": {
        "properties": {
          "person_id": {
            "type": "string",
            "title": "Person Id",
            "description": "El código para ver o borrar el registro: guárdalo."
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "consent_version": {
            "type": "string",
            "title": "Consent Version"
          },
          "consented_at": {
            "type": "string",
            "format": "date-time",
            "title": "Consented At"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "shots": {
            "type": "integer",
            "title": "Shots"
          }
        },
        "type": "object",
        "required": [
          "person_id",
          "display_name",
          "consent_version",
          "consented_at",
          "created_at",
          "expires_at",
          "shots"
        ],
        "title": "Person",
        "description": "Lo que el servicio guarda de una persona, salvo sus embeddings."
      },
      "Pose": {
        "type": "string",
        "enum": [
          "front",
          "left",
          "right"
        ],
        "title": "Pose",
        "description": "Hacia dónde mira la persona en una toma, desde su punto de vista: «izquierda» es su\nizquierda, que en una foto sin espejar queda a la derecha de la imagen."
      },
      "RejectionReason": {
        "type": "string",
        "enum": [
          "no_face",
          "multiple_faces",
          "face_cut_off",
          "face_too_small",
          "too_dark",
          "overexposed",
          "blurry",
          "head_tilted",
          "turned_too_far",
          "looking_up",
          "looking_down",
          "pose_unclear",
          "pose_already_taken",
          "pose_not_in_plan",
          "different_person"
        ],
        "title": "RejectionReason",
        "description": "Por qué no se acepta una toma. El valor es el código que recibe la interfaz."
      },
      "ShotQuality": {
        "properties": {
          "face_width": {
            "type": "number",
            "title": "Face Width"
          },
          "outside_fraction": {
            "type": "number",
            "title": "Outside Fraction"
          },
          "brightness": {
            "type": "number",
            "title": "Brightness"
          },
          "overexposed_fraction": {
            "type": "number",
            "title": "Overexposed Fraction"
          },
          "sharpness": {
            "type": "number",
            "title": "Sharpness"
          },
          "yaw": {
            "type": "number",
            "title": "Yaw"
          },
          "pitch": {
            "type": "number",
            "title": "Pitch"
          },
          "roll": {
            "type": "number",
            "title": "Roll"
          }
