        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "purpose": {
            "type": "string",
            "title": "Purpose"
          },
          "stored_data": {
            "items": {
              "type": "string"
            },
            "type": "array",
