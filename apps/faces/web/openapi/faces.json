        "type": "object",
        "required": [
          "enrollment_id",
          "display_name",
          "poses",
          "covered",
          "remaining",
          "attempts_left",
          "expires_at",
          "message"
        ],
        "title": "Enrollment",
        "description": "Una sesión de registro: qué poses pide, cuáles tiene y qué hacer ahora."
      },
