        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Enrolled"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/identify": {
      "post": {
        "summary": "Identify",
        "operationId": "identify_identify_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_identify_identify_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identification"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/person": {
      "get": {
        "summary": "Person",
        "operationId": "person_person_get",
        "parameters": [
          {
            "name": "X-Person-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "description": "El código que se recibió al registrarse.",
              "title": "X-Person-Id"
            },
            "description": "El código que se recibió al registrarse."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Person"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Forget Person",
        "description": "Borra a la persona y todos sus embeddings. Responde igual si ya no estaba.",
        "operationId": "forget_person_person_delete",
        "parameters": [
          {
            "name": "X-Person-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "description": "El código que se recibió al registrarse.",
              "title": "X-Person-Id"
            },
            "description": "El código que se recibió al registrarse."
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
