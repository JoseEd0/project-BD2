# Lo mismo por HTTP y por HTTPS: cada `server` lo incluye.

server_name _;
root /usr/share/nginx/html;
access_log /dev/stdout app;

# `$csp_script_hashes`: los hashes de los guiones en línea del build, medidos al construir.
include /etc/nginx/app/csp.conf;

# Las métricas de la API las lee Prometheus por la red de la app, no el navegador.
location = /api/metrics {
    return 404;
}

location /api/ {
    limit_req zone=api_per_ip burst=${API_RATE_BURST} nodelay;
    client_max_body_size ${API_MAX_BODY_SIZE};

    # Con una variable, nginx resuelve el nombre en cada petición (con la caché del resolver)
    # en lugar de una sola vez al arrancar.
    proxy_pass ${API_UPSTREAM}$api_request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_trace_id;
    # Un WebSocket (la cámara de rostros) pasa por la misma ruta: nginx reenvía la petición
    # de cambio de protocolo y deja la conexión abierta.
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout ${API_TIMEOUT};

    include /etc/nginx/conf.d/app/headers.conf;
}

location /assets/ {
    include /etc/nginx/conf.d/app/headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
}

# El service worker y el manifiesto se revalidan siempre: si quedaran en caché, una versión
# nueva no llegaría nunca.
location ~ ^/(sw\.js|workbox-[^/]+\.js|manifest\.webmanifest)$ {
    include /etc/nginx/conf.d/app/headers.conf;
    add_header Cache-Control "no-cache";
    try_files $uri =404;
}

location / {
    include /etc/nginx/conf.d/app/headers.conf;
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
}
