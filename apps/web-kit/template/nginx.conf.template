# El nginx de una app: sirve su interfaz y reenvía /api solo a su propia API. Las variables
# (`WEB_PORT`, `API_UPSTREAM`, `API_TIMEOUT`) las sustituye la imagen de nginx al arrancar.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen ${WEB_PORT};
    server_name _;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Un WebSocket (la cámara de rostros) pasa por la misma ruta: nginx reenvía la
        # petición de cambio de protocolo y deja la conexión abierta.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout ${API_TIMEOUT};
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # El service worker y el manifiesto se revalidan siempre: si quedaran en caché, una
    # versión nueva no llegaría nunca.
    location ~ ^/(sw\.js|workbox-[^/]+\.js|manifest\.webmanifest)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
