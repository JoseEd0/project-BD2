              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/tables/upload": {
      "post": {
        "summary": "Upload",
        "description": "Crea una tabla a partir de un CSV subido, deduciendo el esquema del archivo.\n\nEl CSV solo hace falta mientras se carga: va a un directorio propio de la petición y se\nborra al terminar, haya salido bien o no.",
        "operationId": "upload_tables_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_tables_upload_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{identifier}/close": {
      "post": {
        "summary": "Close Session",
        "description": "Cierra la sesión de quien llama y aborta lo que tuviera abierto; la de otro servicio\ncon el mismo identificador no se toca.\n\nEs `POST` y no `DELETE` porque la llama `navigator.sendBeacon` al cerrar la pestaña: es\nla única petición que el navegador garantiza enviar mientras descarga la página, y\nsolo sabe hacer `POST`.",
        "operationId": "close_session_sessions__identifier__close_post",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Identifier"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "boolean"
                  },
                  "title": "Response Close Session Sessions  Identifier  Close Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/media/queries": {
      "post": {
        "tags": [
          "multimedia"
        ],
        "summary": "Upload Query",
        "description": "Guarda el archivo de una consulta y devuelve la ruta que va en `SIMILAR_TO`.\n\nSe guarda con un nombre nuevo, así que dos consultas con el mismo nombre de archivo no\nse pisan; las más viejas se borran al pasar de `max_query_uploads`.",
        "operationId": "upload_query_media_queries_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_query_media_queries_post"
