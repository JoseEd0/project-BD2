    "/tables/{name}/structure": {
      "get": {
        "summary": "Table Structure",
        "description": "Organización física de la tabla y forma real de sus índices: niveles del B+,\nprofundidad global y cubetas del hash. Lee con bloqueo compartido sobre la tabla.",
        "operationId": "table_structure_tables__name__structure_get",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          },
          {
            "name": "session_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Sesión del cliente, para leer dentro de su transacción",
              "title": "Session Id"
            },
            "description": "Sesión del cliente, para leer dentro de su transacción"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Table Structure Tables  Name  Structure Get"
                }
              }
            }
