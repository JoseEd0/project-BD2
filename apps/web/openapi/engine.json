              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/tables/{name}/points": {
      "get": {
        "summary": "Table Points",
        "description": "Puntos de una columna POINT para el panel de mapa; sin `column`, la primera.\n\nCon más filas que `limit` devuelve una muestra tomada a intervalos regulares, para\nque el mapa siga siendo fluido y la muestra no se concentre en una zona. Lee con\nbloqueo compartido sobre la tabla.",
        "operationId": "table_points_tables__name__points_get",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          },
          {
            "name": "column",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Columna POINT",
              "title": "Column"
            },
            "description": "Columna POINT"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Máximo de puntos",
              "title": "Limit"
            },
            "description": "Máximo de puntos"
          },
          {
            "name": "session_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Sesión del cliente, para leer dentro de su transacción",
              "title": "Session Id"
            },
            "description": "Sesión del cliente, para leer dentro de su transacción"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TablePoints"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/query": {
      "post": {
        "summary": "Query",
        "description": "Ejecuta el script del editor y devuelve las filas y el plan de la última consulta.\n\nLas sentencias corren en orden y el script se detiene en la primera que falle: las\nanteriores ya quedaron aplicadas, igual que en cualquier gestor fuera de una\ntransacción. Un `BEGIN` necesita `session_id`: sin sesión no habría dónde guardar la\ntransacción entre una petición y la siguiente. `params` lleva los valores de `$1`, `$2`,\n…, y entonces `sql` tiene que ser una sola sentencia. El rol de quien llama tiene que\nalcanzar para todo el script antes de ejecutar la primera sentencia.",
        "operationId": "query_query_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/files/upload": {
      "post": {
        "summary": "Upload File",
        "description": "Solo guarda el archivo, sin crear tabla; si ya había uno con ese nombre, lo reemplaza.\n\nDevuelve la ruta y las columnas para que la tabla se cree a mano con\n`CREATE TABLE ... FROM FILE`, eligiendo la organización en el propio SQL.",
        "operationId": "upload_file_files_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_file_files_upload_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
