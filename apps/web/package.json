{
  "name": "minigestor-apps-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "contracts": "npm run contracts:export && npm run contracts:types",
    "contracts:export": "uv run --no-sync --directory ../.. python -m tools.export_openapi --output apps/web/openapi",
    "contracts:types": "node scripts/generate-types.ts openapi src/api/generated",
    "icons": "node scripts/generate-icons.ts public/icons"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@tanstack/react-query": "5.105.3",
    "openapi-fetch": "0.17.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "27.4.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.12",
    "workbox-window": "7.4.1"
  }
}
