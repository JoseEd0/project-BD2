# URL del API del motor. El frontend nunca la incrusta en el código.
VITE_API_URL=http://localhost:8000

# Teselas del panel de mapa (opcional). Por omisión se usan las de OpenStreetMap; cambia
# las dos líneas juntas, porque cada proveedor exige su propia atribución.
# VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap
